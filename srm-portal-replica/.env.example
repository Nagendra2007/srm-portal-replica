# Copy to .env — .gitignore already excludes .env but not .env.example.

PORT=3000
HOST=0.0.0.0

# Number of proxy hops in front of Node. 1 when nginx is the only proxy.
# Wrong values here break rate limiting: too high and a client can spoof its
# IP via X-Forwarded-For, too low and everyone shares one bucket.
TRUST_PROXY_HOPS=1

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty for same-origin only, which is all this app actually needs.
CORS_ORIGINS=

# Directory holding eng.traineddata for the OCR captcha solver. Defaults to
# the repo root. eng.traineddata is NOT committed to this repo. If it is
# absent, tesseract.js downloads the model from cdn.jsdelivr.net on first use
# and caches it here, so this now self-heals given outbound network access.
# For an offline or faster cold start, drop the file in yourself:
#   https://github.com/tesseract-ocr/tessdata_fast/raw/main/eng.traineddata
# (tessdata_fast is correct here — the code requests OEM 1, LSTM only.)
TESSDATA_PATH=

# Coordinates submitted with attendance marking. See AUDIT-REPORT.md before
# setting these — the endpoint is geofenced on purpose.
ATTENDANCE_LATITUDE=
ATTENDANCE_LONGITUDE=

# How long to wait for the OCR worker to initialise before giving up and
# returning 503. With no local model and no route to cdn.jsdelivr.net,
# tesseract.js never settles on its own — verified hanging past 120s.
OCR_INIT_TIMEOUT_MS=60000

# After a failed OCR init, skip retrying for this long. A failed createWorker
# leaves an unreachable worker thread behind, so retrying per-login would
# accumulate dead threads.
OCR_FAIL_COOLDOWN_MS=60000
